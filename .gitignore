# R
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj

# Environment and secrets, never commit these
.Renviron
.env
.env.*

# renv: the lockfile is committed, the library is not
renv/library/
renv/local/
renv/staging/
renv/sandbox/
renv/python/

# Local working notes and plans
docs/local/

# Catalog build scratch space. The finished snapshot lives in data/.
# The study explorer export is a 20 MB intermediate: it makes a rebuild take
# two minutes instead of thirty, but build_catalog.R works without it.
data-raw/parts/
data-raw/parts-*/
data-raw/*.csv
*.rds.tmp

# Node and Vite, used from the React front end onward
node_modules/
.vite/

# Deployment: local records of what was deployed where, never source.
rsconnect/
.posit/

# Misc
.DS_Store
*.log
